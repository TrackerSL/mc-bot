# ---- bot identity / server ----
PLAYER_NAME=YourName
SERVER_IP=mc.example.com
SERVER_PORT=25565

# ---- AuthMe (the server login) ----
# PASSWORD is used automatically for /register (first time) and /login
# AUTH=on  -> bot handles /register + /login for you
# AUTH=off -> server has no login, bot skips it
PASSWORD=changeme
AUTH=on

# ---- command queue ----
# ms to wait BEFORE every command (including the very first one)
CMD_DELAY_MS=5000

# commands to run automatically once logged in, comma separated.
# /register and /login are built in — only put gameplay commands here.
CMDS=/lifesteal,/afk
